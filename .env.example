# ── DoochyWeb ───────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is git-ignored; this file is not.

# HTTP port. The server binds to 127.0.0.1 only - put nginx in front of it.
PORT=9111

# MongoDB (the local mongo:7.0 container)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=doochyweb

# Secret used to sign login JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── Analysis page (market technical analysis) ───────────────────────────────
# Twelve Data (FREE tier, 800 requests/day, 8/min) unlocks real data for
# forex, metals, indices and stocks from a single source. Get a key in ~10
# seconds: https://twelvedata.com/pricing
#
# This is the ONLY place the key is configured - it is never stored in Mongo and
# never returned over the API. Without it, crypto still works live via Binance
# and everything else falls back to Yahoo / Stooq and then to a clearly-labelled
# simulator. The Analysis settings panel shows which state you are in.
TWELVEDATA_API_KEY=

# Optional overrides for the Analysis page. Without these the values are edited
# in the Analysis settings panel and persisted in Mongo.
# REFRESH_SECONDS=60
# DEFAULT_TIMEFRAME=1d
# STRONG_RATIO=0.25

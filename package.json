{
  "name": "doochyweb",
  "version": "1.0.0",
  "private": true,
  "description": "Web dashboard for managing cTrader accounts",
  "scripts": {
    "dev:server": "tsx src/server/index.ts",
    "dev:web": "vite",
    "typecheck:web": "tsc -p src/webapp/tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && pnpm typecheck:web && pnpm typecheck:test",
    "build": "tsc -p tsconfig.server.json && pnpm typecheck:web && pnpm typecheck:test && vite build",
    "test": "tsx --test test/market.test.ts",
    "start": "node dist/server/index.js"
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@reiryoku/ctrader-layer": "^2.2.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "framer-motion": "^11.18.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "mongoose": "^8.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}